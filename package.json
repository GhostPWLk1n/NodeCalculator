{
  "name": "nodecalculate",
  "version": "1.8.69",
  "description": "Нодовый калькулятор - визуальный калькулятор с нодовой системой",
  "main": "main.js",
  "author": "Pavel Fomin",
  "license": "MIT",
  "homepage": "https://github.com/GhostPWLk1n/NodeCalculator.git",
  "scripts": {
    "start": "electron .",
    "pack": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "dist:win:all": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --ia32"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.nodecalculate.app",
    "productName": "NodeCalculate",
    "copyright": "Copyright © 2024 NodeCalculate Team, Pavel Fomin",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NodeCalculate"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
